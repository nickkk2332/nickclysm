        ],
        [
          "EOC_LEVELER_UNDINE_SUMMON_KRAKEN",
          { "math": [ "( u_spell_level('summon_kraken') >= 0 ) * ( u_spell_level('summon_kraken') < 35 ) * 4" ] }
        ],
        [
