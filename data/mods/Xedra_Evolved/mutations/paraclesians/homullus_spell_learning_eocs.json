[
  {
    "type": "effect_on_condition",
    "id": "EOC_HOMULLUS_SPELL_EXPERIENCE_INCREASER",
    "//": "Must be in a city or a faction camp",
    "recurrence": [ "6 h", "36 h" ],
    "condition": {
      "and": [
        { "u_has_trait": "HOMULLUS" },
        {
          "u_has_any_trait": [
            "HOMULLUS_CHARM_FERALS",
            "HOMULLUS_SUMMON_FERALS",
            "HOMULLUS_SELF_DECEPTION",
            "HOMULLUS_INVISIBLE_TO_HUMANS",
            "HOMULLUS_REDUCED_VISIBILITY_ALLY",
            "HOMULLUS_RESTORE_POWER",
            "HOMULLUS_ADD_LEARNING_FOCUS",
            "HOMULLUS_ROAD_TRANSLOCATION",
            "HOMULLUS_CULTIVATE_GOBLIN_FRUIT",
            "PARACLESIAN_MAKE_GOSSAMER"
          ]
        }
      ]
    },
    "deactivate_condition": { "not": { "u_has_trait": "HOMULLUS" } },
    "effect": [
      { "u_location_variable": { "context_val": "check_loc" } },
      {
        "run_eocs": [
          {
            "id": "EOC_HOMULLUS_SPELL_EXPERIENCE_INCREASER_2",
            "condition": {
              "or": [
                { "test_eoc": "EOC_CONDITION_HOMULLUS_NEAR_FACTION" },
                { "test_eoc": "EOC_CONDITION_SKY_ISLAND_ON_THE_ISLAND" },
                { "u_near_om_location": "FACTION_CAMP_ANY", "range": 2 },
                { "map_in_city": { "context_val": "check_loc" } }
              ]
            },
            "effect": [ { "run_eocs": "EOC_HOMULLUS_SPELL_EXPERIENCE_INCREASER_SELECTOR" } ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_HOMULLUS_SPELL_EXPERIENCE_INCREASER_SELECTOR",
    "//": "Picks a spell to improve, weighted by [11-Difficulty].  A spell the character doesn't know, or that is at its cap, weighs 0, so only a spell that can improve is picked, and nothing happens when none can.",
    "condition": {
      "or": [
        { "math": [ "u_spell_level('homullus_charm_feral_spell') < int_to_level(1)" ] },
        { "math": [ "u_spell_level('homullus_summon_feral_spell') < 35" ] },
        { "math": [ "u_spell_level('homullus_self_deception_spell') < per_to_level(1)" ] },
        { "math": [ "u_spell_level('homullus_invisible_to_humans_spell') < int_to_level(1)" ] },
        { "math": [ "u_spell_level('homullus_reduced_visibility_ally_spell') < int_to_level(1)" ] },
        { "math": [ "u_spell_level('homullus_restore_power_spell') < int_to_level(1)" ] },
        { "math": [ "u_spell_level('homullus_add_learning_focus_spell') < int_to_level(1)" ] },
        { "math": [ "u_spell_level('homullus_road_translocate_spell') < per_to_level(1)" ] },
        { "math": [ "u_spell_level('homullus_cultivate_goblin_fruit') < int_to_level(1)" ] },
        { "math": [ "u_spell_level('paraclesian_spell_make_gossamer') < 8" ] }
      ]
    },
    "effect": {
      "weighted_list_eocs": [
        [
          "EOC_LEVELER_HOMULLUS_CHARM_FERALS",
          {
            "math": [
              "( u_spell_level('homullus_charm_feral_spell') >= 0 ) * ( u_spell_level('homullus_charm_feral_spell') < int_to_level(1) ) * 9"
            ]
          }
        ],
        [
          "EOC_LEVELER_HOMULLUS_SUMMON_FERALS",
          {
            "math": [ "( u_spell_level('homullus_summon_feral_spell') >= 0 ) * ( u_spell_level('homullus_summon_feral_spell') < 35 ) * 8" ]
          }
        ],
        [
          "EOC_LEVELER_HOMULLUS_SELF_DECEPTION",
          {
            "math": [
              "( u_spell_level('homullus_self_deception_spell') >= 0 ) * ( u_spell_level('homullus_self_deception_spell') < per_to_level(1) ) * 7"
            ]
          }
        ],
        [
          "EOC_LEVELER_HOMULLUS_INVISIBLE_TO_HUMANS",
          {
            "math": [
              "( u_spell_level('homullus_invisible_to_humans_spell') >= 0 ) * ( u_spell_level('homullus_invisible_to_humans_spell') < int_to_level(1) ) * 5"
            ]
          }
        ],
        [
          "EOC_LEVELER_HOMULLUS_REDUCED_VISIBILITY_ALLY",
          {
            "math": [
              "( u_spell_level('homullus_reduced_visibility_ally_spell') >= 0 ) * ( u_spell_level('homullus_reduced_visibility_ally_spell') < int_to_level(1) ) * 7"
            ]
          }
        ],
        [
          "EOC_LEVELER_HOMULLUS_RESTORE_POWER",
          {
            "math": [
              "( u_spell_level('homullus_restore_power_spell') >= 0 ) * ( u_spell_level('homullus_restore_power_spell') < int_to_level(1) ) * 6"
            ]
          }
        ],
        [
          "EOC_LEVELER_HOMULLUS_ADD_LEARNING_FOCUS",
          {
            "math": [
              "( u_spell_level('homullus_add_learning_focus_spell') >= 0 ) * ( u_spell_level('homullus_add_learning_focus_spell') < int_to_level(1) ) * 4"
            ]
          }
        ],
        [
          "EOC_LEVELER_HOMULLUS_ROAD_TRANSLOCATION",
          {
            "math": [
              "( u_spell_level('homullus_road_translocate_spell') >= 0 ) * ( u_spell_level('homullus_road_translocate_spell') < per_to_level(1) ) * 3"
            ]
          }
        ],
        [
          "EOC_LEVELER_HOMULLUS_CULTIVATE_GOBLIN_FRUIT",
          {
            "math": [
              "( u_spell_level('homullus_cultivate_goblin_fruit') >= 0 ) * ( u_spell_level('homullus_cultivate_goblin_fruit') < int_to_level(1) ) * 3"
            ]
          }
        ],
        [
          "EOC_LEVELER_HOMULLUS_MAKE_GOSSAMER",
          {
            "math": [
              "( u_spell_level('paraclesian_spell_make_gossamer') >= 0 ) * ( u_spell_level('paraclesian_spell_make_gossamer') < 8 ) * 4"
            ]
          }
        ]
      ]
    }
