[
  {
    "type": "effect_on_condition",
    "id": "EOC_TEST_ERRAND_TRUE",
    "//": "Errand tests (tests/npc_errand_test.cpp): the true_eocs of the walk and item effects.  Records the outcome, its reason, the name of u and of npc, and counts the runs.",
    "effect": [
      { "set_string_var": "true", "target_var": { "global_val": "test_errand_result" } },
      { "copy_var": { "context_val": "reason" }, "target_var": { "global_val": "test_errand_reason" } },
      { "set_string_var": "<u_name>", "target_var": { "global_val": "test_errand_u" }, "parse_tags": true },
      {
        "if": "has_beta",
        "then": { "set_string_var": "<npc_name>", "target_var": { "global_val": "test_errand_npc" }, "parse_tags": true },
        "else": { "set_string_var": "none", "target_var": { "global_val": "test_errand_npc" } }
      },
      { "math": [ "test_errand_runs++" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_TEST_ERRAND_FALSE",
    "//": "Errand tests: the false_eocs of the walk and item effects, recording as EOC_TEST_ERRAND_TRUE does.",
    "effect": [
      { "set_string_var": "false", "target_var": { "global_val": "test_errand_result" } },
      { "copy_var": { "context_val": "reason" }, "target_var": { "global_val": "test_errand_reason" } },
      { "set_string_var": "<u_name>", "target_var": { "global_val": "test_errand_u" }, "parse_tags": true },
      {
        "if": "has_beta",
        "then": { "set_string_var": "<npc_name>", "target_var": { "global_val": "test_errand_npc" }, "parse_tags": true },
        "else": { "set_string_var": "none", "target_var": { "global_val": "test_errand_npc" } }
      },
      { "math": [ "test_errand_runs++" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_TEST_ERRAND_TAG",
    "//": "Errand tests: the true_eocs of a walk started with the context value errand_tag, which it copies to a global.",
    "effect": [ { "copy_var": { "context_val": "errand_tag" }, "target_var": { "global_val": "test_errand_tag" } } ]
  }
]
