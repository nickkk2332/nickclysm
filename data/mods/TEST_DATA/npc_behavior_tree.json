[
  {
    "//": "Editing the shared NPC decision tree (tests/npc_behavior_tree_test.cpp).  Combat deleted.",
    "type": "behavior",
    "id": "test_bt_no_combat",
    "copy-from": "npc_decision",
    "delete": { "children": [ "npc_combat" ] }
  },
  {
    "type": "behavior",
    "id": "test_bt_inserts",
    "copy-from": "npc_decision",
    "extend": {
      "children": [
        { "id": "test_bt_leaf_first", "before": "npc_combat" },
        { "id": "test_bt_leaf_middle", "after": "npc_combat" },
        "test_bt_leaf_last"
      ]
    }
  },
  {
    "//": "Combat replaced in place: inserted before the child it deletes.",
    "type": "behavior",
    "id": "test_bt_replaced",
    "copy-from": "npc_decision",
    "extend": { "children": [ { "id": "test_bt_leaf_first", "before": "npc_combat" } ] },
    "delete": { "children": [ "npc_combat" ] }
  },
  {
    "//": "A child moved: deleted, and inserted again elsewhere.",
    "type": "behavior",
    "id": "test_bt_moved",
    "copy-from": "npc_decision",
    "extend": { "children": [ { "id": "npc_priorities", "before": "npc_combat" } ] },
    "delete": { "children": [ "npc_priorities" ] }
  },
  {
    "type": "behavior",
    "id": "test_bt_leaf_first",
    "conditions": [ { "predicate": "condition", "condition": { "u_has_trait": "IGNORE_SOUND" } } ],
    "goal": "test_first"
  },
  {
    "type": "behavior",
    "id": "test_bt_leaf_middle",
    "conditions": [ { "predicate": "condition", "condition": { "math": [ "u_bt_devotion > 50" ] } } ],
    "goal": "test_middle"
  },
  {
    "type": "behavior",
    "id": "test_bt_leaf_last",
    "goal": "test_last"
  },
  {
    "//": "Built-in nodes re-conditioned and re-scored.",
    "type": "behavior",
    "id": "test_bt_fight_anyway",
    "copy-from": "npc_fight",
    "delete": { "conditions": [ "npc_has_target" ] }
  },
  {
    "type": "behavior",
    "id": "test_bt_fight_devout",
    "copy-from": "npc_fight",
    "delete": { "conditions": [ "npc_has_target" ] },
    "extend": { "conditions": [ { "predicate": "condition", "condition": { "math": [ "u_bt_devotion > 50" ] } } ] }
  },
  {
    "type": "behavior",
    "id": "test_bt_thirst_half",
    "copy-from": "npc_thirst",
    "score": { "named": "npc_thirst_urgency", "mult": 0.5 }
  },
  {
    "//": "Condition predicates.",
    "type": "behavior",
    "id": "test_bt_has_trait",
    "conditions": [ { "predicate": "condition", "condition": { "u_has_trait": "IGNORE_SOUND" } } ],
    "goal": "test_has_trait"
  },
  {
    "type": "behavior",
    "id": "test_bt_lacks_trait",
    "conditions": [ { "predicate": "condition", "condition": { "u_has_trait": "IGNORE_SOUND" }, "invert_result": true } ],
    "goal": "test_lacks_trait"
  },
  {
    "//": "Score forms.",
    "type": "behavior",
    "id": "test_bt_score_named",
    "goal": "test_score",
    "score": { "named": "npc_thirst_urgency" }
  },
  {
    "type": "behavior",
    "id": "test_bt_score_half",
    "goal": "test_score",
    "score": { "named": "npc_thirst_urgency", "mult": 0.5 }
  },
  {
    "type": "behavior",
    "id": "test_bt_score_oracle",
    "goal": "test_score",
    "score": { "math": [ "oracle('npc_thirst_urgency') * 2" ] }
  },
  {
    "type": "behavior",
    "id": "test_bt_score_math",
    "goal": "test_score",
    "score": { "math": [ "u_bt_devotion / 100" ] }
  },
  {
    "type": "behavior",
    "id": "test_bt_pray_or_drink",
    "strategy": "utility",
    "children": [ "test_bt_pray", "test_bt_drink" ]
  },
  {
    "type": "behavior",
    "id": "test_bt_pray",
    "goal": "test_pray",
    "score": { "math": [ "u_bt_devotion / 100" ] }
  },
  {
    "type": "behavior",
    "id": "test_bt_drink",
    "goal": "test_drink",
    "score": { "math": [ "oracle('npc_thirst_urgency')" ] }
  },
  {
    "//": "Conditions and score reused for 5 turns.",
    "type": "behavior",
    "id": "test_bt_cached",
    "evaluate_every": "5 turns",
    "conditions": [ { "predicate": "condition", "condition": { "math": [ "u_bt_devotion > 50" ] } } ],
    "goal": "test_cached",
    "score": { "math": [ "u_bt_devotion / 100" ] }
  }
]
