    "eoc_type": "EVENT",
    "required_event": "character_wakes_up",
    "condition": { "math": [ "audit_m07a_listen == 1" ] },
    "effect": [ { "copy_var": { "context_val": "cause" }, "target_var": { "global_val": "audit_m07a_wake_cause" } } ]
  }
