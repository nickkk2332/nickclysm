  {
    "type": "effect_on_condition",
    "id": "EOC_AUDIT_M07A_TELEPORTED",
    "//": "SPAT-J04: records creature_teleported while a test listens.",
    "eoc_type": "EVENT",
    "required_event": "creature_teleported",
    "condition": { "math": [ "audit_m07a_listen == 1" ] },
    "effect": [
      { "math": [ "audit_m07a_teleports += 1" ] },
      {
        "if": "u_is_monster",
        "then": [ { "math": [ "audit_m07a_teleported_monster = 1" ] } ],
        "else": [ { "math": [ "audit_m07a_teleported_monster = 0" ] } ]
      },
      { "copy_var": { "context_val": "from" }, "target_var": { "global_val": "audit_m07a_teleport_from" } },
      { "copy_var": { "context_val": "to" }, "target_var": { "global_val": "audit_m07a_teleport_to" } }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_AUDIT_M07A_HEARS",
    "//": "SPAT-J05: records character_hears_sound for alarms while a test listens.",
    "eoc_type": "EVENT",
    "required_event": "character_hears_sound",
    "condition": {
      "and": [ { "math": [ "audit_m07a_listen == 1" ] }, { "compare_string": [ { "context_val": "category" }, "alarm" ] } ]
    },
    "effect": [
      { "math": [ "audit_m07a_heard += 1" ] },
      { "copy_var": { "context_val": "volume" }, "target_var": { "global_val": "audit_m07a_heard_raw" } },
      { "copy_var": { "context_val": "heard_volume" }, "target_var": { "global_val": "audit_m07a_heard_volume" } },
      { "copy_var": { "context_val": "location" }, "target_var": { "global_val": "audit_m07a_heard_loc" } }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_AUDIT_M07A_WAKES",
