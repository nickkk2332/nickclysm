[
  {
    "//": "EVT-J07: writing these sends var_changed, however they are written",
    "type": "watched_variable",
    "variables": [ "audit_m03b_watched", "audit_m03b_loop" ]
  },
  {
    "//": "EVT-J07: a var_changed EOC that writes the variable it watches must not loop",
    "type": "effect_on_condition",
    "id": "EOC_AUDIT_M03B_VAR_LOOP",
    "eoc_type": "EVENT",
    "required_event": "var_changed",
    "condition": { "compare_string": [ "audit_m03b_loop", { "context_val": "var" } ] },
    "effect": [
      { "math": [ "u_audit_m03b_loop = u_audit_m03b_loop + 1" ] },
      { "math": [ "audit_m03b_loop_runs = audit_m03b_loop_runs + 1" ] }
    ]
  },
