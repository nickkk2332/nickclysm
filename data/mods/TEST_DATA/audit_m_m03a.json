[
  {
    "type": "effect_type",
    "id": "audit_m03a_hooked",
    "name": [ "Audit Hooked" ],
    "desc": [ "EVT-J04: runs EOCs when gained, changed and lost." ],
    "max_intensity": 5,
    "apply_eocs": [ "EOC_audit_m03a_applied" ],
    "intensity_change_eocs": [
      {
        "id": "EOC_audit_m03a_intensity_changed",
        "effect": [
          { "math": [ "u_audit_m03a_changed += 1" ] },
          { "math": [ "u_audit_m03a_new = _intensity" ] },
          { "math": [ "u_audit_m03a_old = _old_intensity" ] }
        ]
      }
    ],
    "remove_eocs": [ "EOC_audit_m03a_removed" ]
  },
  {
    "type": "effect_type",
    "id": "audit_m03a_decaying",
    "copy-from": "audit_m03a_hooked",
    "name": [ "Audit Decaying" ],
    "desc": [ "EVT-J04: inherits the intensity EOCs, drops the apply EOCs, and decays every turn." ],
    "int_decay_tick": 1,
    "delete": { "apply_eocs": [ "EOC_audit_m03a_applied" ] }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_audit_m03a_applied",
    "effect": [
      { "math": [ "u_audit_m03a_applied += 1" ] },
      { "math": [ "u_audit_m03a_new = _intensity" ] },
      { "math": [ "u_audit_m03a_old = _old_intensity" ] },
      {
        "if": { "compare_string": [ "torso", { "context_val": "bodypart" } ] },
        "then": { "math": [ "u_audit_m03a_on_torso += 1" ] }
      },
      {
        "if": { "compare_string": [ "audit_m03a_hooked", { "context_val": "effect" } ] },
        "then": { "math": [ "u_audit_m03a_named += 1" ] }
      },
      { "if": "has_beta", "then": { "math": [ "n_audit_m03a_caused += 1" ] } }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_audit_m03a_removed",
    "effect": [
      { "math": [ "u_audit_m03a_removed += 1" ] },
      { "math": [ "u_audit_m03a_new = _intensity" ] },
      { "math": [ "u_audit_m03a_old = _old_intensity" ] },
      { "if": "has_beta", "then": { "math": [ "n_audit_m03a_caused += 1" ] } }
    ]
  },
  {
    "id": "audit_m03a_given",
