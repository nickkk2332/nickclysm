    "type": "achievement",
    "name": "Audit EVT-J05 untracked",
    "manually_given": true,
    "requirements": [  ]
  },
  {
    "id": "audit_m03a_conduct",
    "type": "conduct",
    "name": "Audit EVT-J05 conduct",
    "requirements": [  ]
  },
  {
    "id": "audit_m03a_late",
    "type": "achievement",
    "name": "Audit EVT-J05 late",
    "allow_late_tracking": true,
    "requirements": [ { "event_statistic": "num_avatar_zombie_kills", "is": ">=", "target": 1 } ]
  },
  {
    "id": "audit_m03a_unlocker",
    "type": "achievement",
    "name": "Audit EVT-J05 unlocker",
    "manually_given": true,
    "unlocks_all_content": true,
    "hidden_by": [ "audit_m03a_unlocker" ],
    "requirements": [  ]
  },
