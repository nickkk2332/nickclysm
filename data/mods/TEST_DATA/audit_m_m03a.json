  },
  {
    "id": "audit_m03a_score",
    "type": "score",
    "statistic": "num_avatar_zombie_kills"
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_audit_m03a_give",
    "effect": [ { "give_achievement": { "global_val": "audit_m03a_target" } } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_audit_m03a_fail",
    "effect": [ { "fail_conduct": { "global_val": "audit_m03a_target" } } ]
  }
]
