  {
    "type": "effect_on_condition",
    "id": "EOC_TEST_AI_ATTITUDE_CHANGED",
    "//": "NPC AI hook tests: records npc_attitude_changed while the global test_ai_listen is 1.",
    "eoc_type": "EVENT",
    "required_event": "npc_attitude_changed",
    "condition": { "math": [ "test_ai_listen == 1" ] },
    "effect": [
      { "math": [ "test_ai_attitude_changes += 1" ] },
      { "copy_var": { "context_val": "old_attitude" }, "target_var": { "global_val": "test_ai_old" } },
      { "copy_var": { "context_val": "new_attitude" }, "target_var": { "global_val": "test_ai_new" } },
      { "copy_var": { "context_val": "cause" }, "target_var": { "global_val": "test_ai_cause" } },
      { "set_string_var": "<u_name>", "target_var": { "global_val": "test_ai_u" }, "parse_tags": true }
    ]
  },
  {
