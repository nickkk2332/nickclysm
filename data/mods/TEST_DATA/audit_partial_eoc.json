  {
    "//": "USE-J01 fixture: copies the method and item_pos context values of its use action to globals.",
    "id": "test_usej01_marker",
    "type": "ITEM",
    "subtypes": [ "TOOL" ],
    "name": { "str": "test use marker", "//~": "NO_I18N" },
    "description": { "str": "Records what its use action was told.", "//~": "NO_I18N" },
    "weight": "10 g",
    "volume": "10 ml",
    "material": [ "stone" ],
    "symbol": ",",
    "color": "blue",
    "use_action": {
      "type": "effect_on_conditions",
      "menu_text": "Mark",
      "effect_on_conditions": [
        {
          "id": "EOC_TEST_USEJ01_MARK",
          "effect": [
            { "copy_var": { "context_val": "method" }, "target_var": { "global_val": "usej01_method" } },
            { "copy_var": { "context_val": "item_pos" }, "target_var": { "global_val": "usej01_item_pos" } },
