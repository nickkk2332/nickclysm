  {
    "//": "HLTH-J14: the per-turn side effects of these traits used to be C++ in suffer.cpp.  Each runs every turn as its trait's processed_eocs, while awake, with the chance the C++ had.",
    "type": "effect_on_condition",
    "id": "EOC_TRAIT_NARCOLEPTIC",
    "condition": { "and": [ { "not": "u_in_sleep_state" }, { "x_in_y_chance": { "x": 1, "y": 28800 } } ] },
    "effect": [
      { "u_message": "You're suddenly overcome with the urge to sleep and you pass out.", "type": "bad" },
      { "u_fall_asleep": "20 minutes" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_TRAIT_MOODSWINGS",
