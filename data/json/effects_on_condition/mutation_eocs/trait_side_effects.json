    "effect": [
      {
        "if": { "x_in_y_chance": { "x": 11, "y": 20 } },
        "then": { "u_add_morale": "morale_moodswing", "bonus": -20, "max_bonus": -100 },
        "else": { "u_add_morale": "morale_moodswing", "bonus": 20, "max_bonus": 100 }
      }
    ]
  },
