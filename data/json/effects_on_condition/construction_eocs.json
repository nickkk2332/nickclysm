[
  {
    "type": "effect_on_condition",
    "id": "EOC_CONSTRUCTION_EXTRACT_MAYBE_REVERT_TO_DIRT",
    "//": "post_eocs of the constructions that extract clay, sand or bog iron (once the done_extract_maybe_revert_to_dirt post_special): one time in ten the deposit is used up and becomes dirt, then it says what was gathered.",
    "effect": [
      {
        "if": { "x_in_y_chance": { "x": 1, "y": 10 } },
        "then": { "set_terrain": "t_dirt", "location": { "context_val": "pos" }, "radius": 0 }
      },
      {
        "if": { "map_terrain_id": "t_clay", "loc": { "context_val": "pos" } },
        "then": { "message": "You gather some clay." },
        "else": {
          "if": { "map_terrain_id": "t_sand", "loc": { "context_val": "pos" } },
          "then": { "message": "You gather some sand." },
          "else": { "message": "You gather some materials." }
        }
      }
    ]
  }
]
